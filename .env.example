# Mẫu cấu hình. Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- AWS S3 (ảnh) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=
S3_PREFIX=images/

# --- Gemini (xử lý query) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=1600

# --- API của hệ thống (cho auto test và load test) ---
API_KEY=

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
